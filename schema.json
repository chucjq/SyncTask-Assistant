{
  "version": 1,
  "description": "Allowlist for the query assistant, derived from the SyncTask app's data model. Checked against the app's firestore.rules by tests/test_schema_contract.py (AQ-17).",
  "id_pattern": "^[A-Za-z0-9_-]{1,128}$",
  "date_pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
  "limits": {
    "min": 1,
    "default": 50,
    "max": 50,
    "max_filters": 10,
    "list_max": 30
  },
  "order_directions": [
    "asc",
    "desc"
  ],
  "operators": {
    "all": [
      "==",
      "!=",
      "<",
      "<=",
      ">",
      ">=",
      "in",
      "not-in",
      "array-contains"
    ],
    "by_type": {
      "string": [
        "==",
        "!=",
        "<",
        "<=",
        ">",
        ">=",
        "in",
        "not-in"
      ],
      "int": [
        "==",
        "!=",
        "<",
        "<=",
        ">",
        ">=",
        "in",
        "not-in"
      ],
      "number": [
        "==",
        "!=",
        "<",
        "<=",
        ">",
        ">=",
        "in",
        "not-in"
      ],
      "boolean": [
        "==",
        "!=",
        "in",
        "not-in"
      ],
      "array": [
        "array-contains"
      ],
      "map": []
    },
    "list_value": [
      "in",
      "not-in"
    ]
  },
  "excluded": {
    "collections": [
      "users",
      "invitations"
    ],
    "fields": [
      "joinInviteId",
      "createdAt",
      "updatedAt",
      "revision"
    ]
  },
  "collections": {
    "projects": {
      "path": "projects",
      "scope": "Only projects whose memberIds contain the verified user id. Applied by the executor, never by the model.",
      "fields": {
        "id": {
          "type": "string",
          "format": "id",
          "doc_id": true,
          "returned": true,
          "ops": [],
          "sortable": false
        },
        "name": {
          "type": "string",
          "returned": true,
          "ops": [
            "==",
            "in"
          ],
          "sortable": true,
          "hint": "project name"
        },
        "description": {
          "type": "string",
          "returned": true,
          "ops": [],
          "sortable": false
        },
        "deadline": {
          "type": "string",
          "format": "date",
          "returned": true,
          "ops": [
            "==",
            "!=",
            "<",
            "<=",
            ">",
            ">="
          ],
          "sortable": true,
          "hint": "project due date"
        },
        "ownerId": {
          "type": "string",
          "format": "id",
          "references": "roster",
          "returned": true,
          "ops": [
            "==",
            "!=",
            "in",
            "not-in"
          ],
          "sortable": false,
          "hint": "user id of the project owner (from the people list)"
        },
        "members": {
          "type": "map",
          "returned": true,
          "ops": [],
          "sortable": false,
          "value": {
            "name": "string",
            "role": [
              "owner",
              "editor",
              "viewer"
            ]
          }
        },
        "memberIds": {
          "type": "array",
          "items": "string",
          "returned": false,
          "ops": [],
          "sortable": false
        },
        "taskIds": {
          "type": "array",
          "items": "string",
          "returned": false,
          "ops": [],
          "sortable": false
        }
      },
      "description": "Projects the user is a member of."
    },
    "tasks": {
      "path": "projects/{projectId}/tasks",
      "scope": "Only inside projects the user is a member of. The executor runs one query per member project.",
      "fields": {
        "id": {
          "type": "string",
          "format": "id",
          "returned": true,
          "ops": [],
          "sortable": false
        },
        "projectId": {
          "type": "string",
          "format": "id",
          "references": "user_projects",
          "returned": true,
          "ops": [
            "==",
            "!=",
            "in",
            "not-in"
          ],
          "sortable": false,
          "hint": "id of the project the task belongs to (from the project list)"
        },
        "title": {
          "type": "string",
          "returned": true,
          "ops": [
            "==",
            "in"
          ],
          "sortable": true,
          "hint": "task title (exact match only)"
        },
        "description": {
          "type": "string",
          "returned": true,
          "ops": [],
          "sortable": false
        },
        "assignedTo": {
          "type": "string",
          "format": "id",
          "references": "roster",
          "returned": true,
          "ops": [
            "==",
            "!=",
            "in",
            "not-in"
          ],
          "sortable": false,
          "hint": "user id of the assignee (from the people list)"
        },
        "deadline": {
          "type": "string",
          "format": "date",
          "returned": true,
          "ops": [
            "==",
            "!=",
            "<",
            "<=",
            ">",
            ">="
          ],
          "sortable": true,
          "hint": "task due date"
        },
        "status": {
          "type": "string",
          "enum": [
            "todo",
            "in_progress",
            "blocked",
            "completed"
          ],
          "returned": true,
          "ops": [
            "==",
            "!=",
            "in",
            "not-in"
          ],
          "sortable": false,
          "hint": "todo = not started, blocked = waiting for the task in dependsOnTaskId"
        },
        "dependsOnTaskId": {
          "type": "string",
          "format": "id",
          "allow_empty": true,
          "references": "task",
          "returned": true,
          "ops": [
            "==",
            "!="
          ],
          "sortable": false,
          "note": "Empty string means no dependency; the app never stores null.",
          "hint": "id of the task this one waits for; empty string \"\" when it has no dependency"
        },
        "checklist": {
          "type": "array",
          "items": "map",
          "item_fields": {
            "id": "string",
            "title": "string",
            "completed": "boolean"
          },
          "item_fields_source": "app types (src/types/index.ts); firestore.rules only checks 'is list' and size <= 30",
          "returned": true,
          "ops": [],
          "sortable": false
        }
      },
      "description": "Tasks inside those projects."
    }
  }
}

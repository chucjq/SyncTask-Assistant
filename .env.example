# Copy to .env (git-ignored). Never put keys or secrets in this file.

# --- Emulator mode (default for development) ---
# Both variables are read by the Firebase Admin SDK (firebase-admin-python).
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Project id. Optional in emulator mode (defaults to demo-synctask-assistant).
# REQUIRED if the emulator variables above are removed (non-emulator project):
# without it the backend refuses to start.
# FIREBASE_PROJECT_ID=demo-synctask-assistant

# --- Dates ---
# IANA time zone used to decide what "today" is (default UTC), and the first day of the week.
# ASSISTANT_TIMEZONE=Europe/Berlin
# ASSISTANT_WEEK_START=monday
